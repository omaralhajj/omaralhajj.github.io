---
import { en as t } from '../i18n'
---

<section class="col pt-20 pb-12 sm:pt-24 sm:pb-16 fade-in">
  <p class="font-mono text-sm mb-4" style="color: var(--color-accent);">
    <span data-i18n="hero_greeting">{t.hero_greeting}</span>
  </p>
  <h1
    class="text-3xl sm:text-4xl font-semibold tracking-tight mb-3"
    style="color: var(--color-text);"
  >
    Omar Alhajj
  </h1>
  <p class="text-lg sm:text-xl mb-6" style="color: var(--color-text-muted);" data-i18n="hero_tagline">
    {t.hero_tagline}
  </p>
  <p class="text-base leading-relaxed" style="color: var(--color-text-muted);" data-i18n="hero_body">
    {t.hero_body}
  </p>
</section>
