---
import { en as t } from '../i18n'
---

<section
  id="about"
  class="col py-12 sm:py-16 border-t fade-in"
  style="border-color: var(--color-border);"
>
  <h2 class="font-mono text-sm mb-6" style="color: var(--color-accent);" data-i18n="about_heading">
    {t.about_heading}
  </h2>
  <p class="text-base leading-relaxed mb-4" style="color: var(--color-text);" data-i18n="about_p1">
    {t.about_p1}
  </p>
  <p class="text-base leading-relaxed" style="color: var(--color-text);" data-i18n="about_p2">
    {t.about_p2}
  </p>
</section>
