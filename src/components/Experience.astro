---
import { en as t } from '../i18n'

const experience = [
  {
    role: t.experience_0_role,
    company: "Bankdata",
    period: "Jan 2024 — Present",
    description: t.experience_0_description,
    highlights: [
      t.experience_0_highlight_0,
      t.experience_0_highlight_1,
      t.experience_0_highlight_2,
      t.experience_0_highlight_3,
      t.experience_0_highlight_4,
    ],
  },
  {
    role: t.experience_1_role,
    company: "Bankdata",
    period: "Nov 2019 — Dec 2023",
    description: t.experience_1_description,
  },
  {
    role: t.experience_2_role,
    company: "EG Silkeborg Data",
    period: "Feb 2018 — Jan 2019",
    description: t.experience_2_description,
  },
];
---

<section
  id="experience"
  class="col py-12 sm:py-16 border-t fade-in"
  style="border-color: var(--color-border);"
>
  <h2
    class="font-mono text-sm mb-8"
    style="color: var(--color-accent);"
    data-i18n="experience_heading"
  >
    {t.experience_heading}
  </h2>
  <div class="space-y-10">
    {
      experience.map((item, index) => (
        <div class="experience-item grid gap-2 sm:grid-cols-[140px_1fr] sm:gap-6">
          <p
            class="font-mono text-xs pt-1"
            style="color: var(--color-text-muted);"
          >
            {item.period}
          </p>
          <div>
            <p
              class="font-medium text-sm mb-0.5"
              style="color: var(--color-text);"
              data-i18n={`experience_${index}_role`}
            >
              {item.role}
            </p>
            <p class="text-sm mb-2" style="color: var(--color-accent);">
              {item.company}
            </p>
            <p
              class="text-sm leading-relaxed"
              style="color: var(--color-text-muted);"
              data-i18n={`experience_${index}_description`}
            >
              {item.description}
            </p>
            {item.highlights && (
              <ul
                class="mt-3 space-y-1 text-sm leading-relaxed list-disc pl-5"
                style="color: var(--color-text-muted);"
              >
                {item.highlights.map((highlight, hIndex) => (
                  <li data-i18n={`experience_${index}_highlight_${hIndex}`}>
                    {highlight}
                  </li>
                ))}
              </ul>
            )}
          </div>
        </div>
      ))
    }
  </div>
</section>
